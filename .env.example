# ──────────────────────────────────────────────────────────────
# OptiLoop Environment Configuration
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────

# REQUIRED: Your OpenRouter API key for LLM access.
# Get a free key at https://openrouter.ai/keys
# Models are billed per-token; the cheapest options cost < $0.01/task.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Backend API URL used by the CLI and web dashboard.
# Change this if running the backend on a different host/port.
OPTILOOP_API_URL=http://localhost:8000

# Optional: Default model preferences per agent role.
# The ModelRouter picks the best model dynamically, but you can
# override with specific model IDs from OpenRouter.
# Examples: "deepseek/deepseek-v4-flash", "anthropic/claude-3.5-sonnet"
DEFAULT_PLANNER_MODEL=
DEFAULT_EXECUTOR_MODEL=
DEFAULT_REVIEWER_MODEL=
